# Copy this file to .env.local and fill in your values.
# These are also added to Vercel → Project → Settings → Environment Variables.

# Supabase — from your project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Web Push VAPID keys — generate with:
#   npx web-push generate-vapid-keys
# The PUBLIC key also goes in app/page.tsx (VAPID_PUBLIC_KEY constant)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:you@example.com
